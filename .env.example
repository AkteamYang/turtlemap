# turtlemap 本地开发配置


# ======LLM======
# 默认模型名称。
# TURTLEMAP_LLM_MODEL=qwen3.8-flash

# 默认模型服务 API Key。
# TURTLEMAP_LLM_API_KEY=sk-ws-***

# 默认模型服务基础地址。
# TURTLEMAP_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 默认模型请求超时时间，单位秒。
TURTLEMAP_LLM_TIMEOUT=60


# ======Context Token Budget======
# 当前模型允许使用的最大上下文窗口 token 数。
TURTLEMAP_CONTEXT_MAX_CONTEXT_TOKENS=32000

# 超过后当前轮必须先同步压缩的硬限制 token 数。
TURTLEMAP_CONTEXT_HARD_LIMIT_TOKENS=3000

# 超过后当前轮可继续但应触发后台压缩的软限制 token 数。
TURTLEMAP_CONTEXT_SOFT_LIMIT_TOKENS=3000

# 超过后应触发后台压缩的历史轮次软限制。
# TURTLEMAP_CONTEXT_SOFT_LIMIT_ROUNDS=10

# 超过后应触发同步压缩的历史轮次软限制。
TURTLEMAP_CONTEXT_HARD_LIMIT_ROUNDS=10

# 每轮压缩后仍保留原始形态的最近历史轮次数。
TURTLEMAP_CONTEXT_KEEP_RECENT_HISTORY_ROUNDS=3


# ======MySQL======
# MySQL 服务地址。
TURTLEMAP_MYSQL_HOST=127.0.0.1

# MySQL 服务端口。
TURTLEMAP_MYSQL_PORT=3306

# MySQL 用户名。
TURTLEMAP_MYSQL_USER=root

# MySQL 密码。
TURTLEMAP_MYSQL_PASSWORD=**

# MySQL 数据库名称。
TURTLEMAP_MYSQL_DATABASE=turtlemap_db

# MySQL 连接字符集。
TURTLEMAP_MYSQL_CHARSET=utf8mb4


# ======Redis======
# Redis 服务地址。
TURTLEMAP_REDIS_HOST=127.0.0.1

# Redis 服务端口。
TURTLEMAP_REDIS_PORT=6379

# Redis 用户名。
TURTLEMAP_REDIS_USERNAME=default

# Redis 密码。
TURTLEMAP_REDIS_PASSWORD=**
